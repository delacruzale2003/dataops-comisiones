{
	"name": "df_comisiones1",
	"properties": {
		"type": "Flowlet",
		"typeProperties": {
			"sources": [],
			"sinks": [],
			"transformations": [
				{
					"name": "srcEmpleado"
				},
				{
					"name": "srcComision"
				}
			],
			"scriptLines": [
				"input(output(",
				"          empleado_id as integer,",
				"          tip_documento as string,",
				"          num_documento as string,",
				"          nom_empleado as string,",
				"          ape_empleado as string,",
				"          cod_cargo as string,",
				"          cod_departamento as string,",
				"          mnt_salario as decimal(38,18),",
				"          mnt_tope_comision as decimal(38,18)",
				"     ),",
				"     order: 0,",
				"     allowSchemaDrift: true) ~> srcEmpleado",
				"input(output(",
				"          {empleado_id;Nombre y Apellido;Comisión} as string",
				"     ),",
				"     order: 1,",
				"     allowSchemaDrift: true) ~> srcComision"
			]
		}
	}
}